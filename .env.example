# Copy to .env (gitignored). Supabase -> Connect -> Session pooler.
# Used by DataScraping/load.py (postgresql:// form):
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Used by the Spring backend (jdbc: form of the same URL, user and password split out):
#   DB_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require&preferQueryMode=simple
#   DB_USERNAME=postgres.PROJECT_REF
#   DB_PASSWORD=PASSWORD
